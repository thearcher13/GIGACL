# GIGACL as a systemd service.
#
# Install:
#   sudo cp deploy/gigacl.service /etc/systemd/system/gigacl.service
#   sudo nano /etc/systemd/system/gigacl.service     # set User, Group, paths
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gigacl
#
# `enable` is the part that survives a reboot; `start` alone does not.
#
# Check it:  systemctl status gigacl
# Follow it: journalctl -u gigacl -f

[Unit]
Description=GIGACL - ACL management for Cisco IOS and NX-OS
Documentation=https://github.com/thearcher13/GIGACL
# Switch SSH needs a network and, for hostnames in the inventory, a resolver.
After=network-online.target
Wants=network-online.target

[Service]
Type=exec

# The account that owns the checkout. Do not use root: this process holds
# switch credentials and opens SSH sessions, and it needs no privilege beyond
# reading its own directory. Create one with:
#   sudo useradd --system --home /opt/gigacl --shell /usr/sbin/nologin gigacl
User=gigacl
Group=gigacl

# Edit both of these to wherever the checkout lives.
WorkingDirectory=/opt/gigacl/backend
ExecStart=/opt/gigacl/venv/bin/python -m uvicorn main:app \
    --host 127.0.0.1 --port 8000 --workers 1 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1

# 127.0.0.1 above assumes the reverse proxy in nginx-gigacl.conf is in front.
# To serve directly with no proxy, change it to 0.0.0.0 and drop the two
# proxy flags -- without a proxy there is no forwarded header to trust, and
# leaving them on would let a client claim any address it liked.

# One worker, always. Live SSH sessions, the terminal's channels and the
# per-user connection pool live in this process's memory, and SQLite takes one
# writer at a time. A second worker would answer half the requests without any
# of that state.

Restart=always
RestartSec=5
# Give in-flight switch commands a moment to finish before the kill.
TimeoutStopSec=30
KillSignal=SIGINT

# Logs go to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gigacl

# --- Hardening. Remove any line that fights your environment. ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The one path it must be able to write: the database, the .env it generates
# the key into, and the audit-log exports.
ReadWritePaths=/opt/gigacl
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# Outbound SSH to the switches and inbound HTTP. No other address families.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
