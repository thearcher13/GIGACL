# GIGACL configuration. Copy to .env and edit; .env is gitignored and must
# stay that way -- it holds the key that every stored switch password is
# encrypted with.
#
# On Linux, keep it readable only by the account that runs the service:
#   chmod 600 .env

# Signing and encryption key. Leave it blank and the app generates one on
# first start and writes it back here. Set it yourself only if you are
# restoring a backup, and then it MUST be the key the backup was made with:
# a different key cannot decrypt the stored switch passwords, and they will
# have to be entered again.
SECRET_KEY=

# How long a sign-in lasts before the token expires, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database location. Relative paths resolve against backend/, which is where
# the server's working directory is set.
DATABASE_URL=sqlite:///./giga_acl.db
